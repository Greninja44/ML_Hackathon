  "loss": "binary cross-entropy (Adam)",
  "seed": 42,
  "data": "Person 1 CSVs (train)",
  "target": "monotone route alignment",
  "max_train_rows": null,
  "feature_columns": [
    "distance_m",
    "dist_rank",
    "dist_minus_min",
    "n_candidates",
    "direction_difference",
    "direction_axis",
    "heading_unreliable",
    "gps_speed_mps",
    "speed_spike",
    "time_gap_sec",
    "road_length_m",
    "has_reverse_twin",
    "ctx_mean_dist_m",
    "ctx_hit_share",
    "prev_link",
    "next_link"
  ]
}