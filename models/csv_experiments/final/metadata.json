{
  "model_name": "mlp_tuned",
  "base_model": "mlp",
  "family": "Neural network",
  "params": {
    "hidden_layer_sizes": [
      256,
      128,
      64
    ],
    "alpha": 9.962513222055122e-06,
    "learning_rate_init": 0.0010677482709481358,
    "max_iter": 200,
    "early_stopping": true,
