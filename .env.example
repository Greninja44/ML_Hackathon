# Copy to .env (never commit .env). All values are optional.
PATHSNAP_DATA_DIR=data/raw            # folder holding train/ student_test/ eval_test/
PATHSNAP_MODEL_DIR=models/final       # final model artifact used by the API
PATHSNAP_SERVE_PARTITION=eval_test    # eval_test on the day; student_test to rehearse
PATHSNAP_CORS_ORIGINS=*               # or e.g. http://192.168.1.21:5173
PATHSNAP_HOST=0.0.0.0
PATHSNAP_PORT=8000
